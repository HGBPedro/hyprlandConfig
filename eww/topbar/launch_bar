#!/bin/bash

EWW=`which eww`
CFG="$HOME/.config/eww/topbar"

## Run eww daemon if not running already
if [[ ! `pidof eww` ]]; then
	${EWW} daemon
	sleep 1
fi

## Open widgets 
run_eww() {
      eww --config "$CFG" open-many datetime \
        workspaces \
        spotify \
        weather \
        user \
        calendar-window \
        levels
}

## Launch or close widgets accordingly
run_eww
